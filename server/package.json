{
  "name": "budgett-server",
  "version": "1.0.0",
  "description": "Budgett API server",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "eslintConfig": {
    "env": {
      "node": true,
      "es2021": true
    },
    "parserOptions": {
      "ecmaVersion": "latest"
    },
    "plugins": [
      "@stylistic"
    ],
    "rules": {
      "curly": [
        "warn",
        "all"
      ],
      "@stylistic/brace-style": [
        "warn",
        "stroustrup"
      ],
      "@stylistic/indent": [
        "warn",
        2
      ],
      "@stylistic/nonblock-statement-body-position": [
        "warn",
        "below"
      ],
      "@stylistic/padding-line-between-statements": [
        "warn",
        { "blankLine": "always", "prev": "block-like", "next": "*" }
      ]
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "plaid": "^28.0.0",
    "socket.io": "^4.7.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^2.13.0",
    "eslint": "^8.57.1",
    "nodemon": "^3.1.4"
  }
}
