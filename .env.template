# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET_SANDBOX=
PLAID_SECRET_PRODUCTION=
PLAID_ENV=sandbox

# Server
PORT=5000

# Database (SQLite file path, relative to server/)
DB_PATH=../database/budgett.db

# Webhooks (Cloudflare Tunnel URL for Plaid callbacks)
WEBHOOK_URL=

# Auth
SESSION_SECRET=change-me-to-a-random-string

# Basic authentication (optional). When REQUIRE_LOGIN=true, the UI shows a password login page and
# every /api endpoint (except the Plaid webhook) requires a login session or API_KEY.
REQUIRE_LOGIN=false
# bcrypt hash of the login password - generate with: cd server && npm run hash-password
LOGIN_PASSWORD_HASH=
# How long a login lasts, e.g. 5d, 24h, 30m (default 7d)
LOGIN_EXPIRATION=7d
# Lets other applications call the /api endpoints (X-API-Key header or Authorization: Bearer).
# Only used when REQUIRE_LOGIN=true; it never grants access to the UI.
API_KEY=
